<Window x:Name="ServicesForm" x:Class="WpfApp1.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Услуги" Height="507.2" Width="925.2" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Icon="internet_102151.ico">
    <Viewbox Stretch="Fill">
        
    <Grid>
        <TextBox TabIndex="1" x:Name="serviceTextBox" HorizontalAlignment="Left" Height="84" Margin="610,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="281" PreviewTextInput="TextBox_PreviewTextInput" FontSize="14"/>
        <Label Content="Услуга" HorizontalAlignment="Left" Margin="610,24,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.893,-0.273" FontSize="14"/>
        <Label Content="Единицы измерения" HorizontalAlignment="Left" Margin="610,132,0,0" VerticalAlignment="Top" FontSize="14"/>
        <DataGrid FontSize="16" IsReadOnly="True" SelectionMode="Single" x:Name="servicesDG" HorizontalAlignment="Left" Height="403" Margin="10,27,0,0" VerticalAlignment="Top" Width="556" AutoGenerateColumns="False" SelectionChanged="servicesDG_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Услуга" Binding="{Binding service_name}" Width="230">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Единицы измерения" Binding="{Binding units}" Width="170" />
                <DataGridTextColumn Header="Цена" Binding="{Binding service_cost}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox TabIndex="2"  x:Name="unitsTextBox" HorizontalAlignment="Left" Height="30" Margin="610,158,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="281" PreviewTextInput="TextBox_PreviewTextInput_1" FontSize="14"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="610,185,0,0" VerticalAlignment="Top" FontSize="14"/>
        <TextBox CommandManager.PreviewExecuted="TextBox_PreviewExecuted" TabIndex="3" x:Name="costTextBox" HorizontalAlignment="Left" Height="30" Margin="610,210,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="281" PreviewTextInput="cost_PreviewTextInput" PreviewKeyDown="cost_PreviewKeyDown" MaxLength="6" FontSize="14"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="651,22,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="742,130,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="644,183,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <StackPanel HorizontalAlignment="Left" Height="182" Margin="610,258,20,0" VerticalAlignment="Top" Width="281">
            <Button x:Name="addServiceButton" Content="Добавить услугу" HorizontalAlignment="Left" Margin="0,0,-0.2,0" VerticalAlignment="Top" Width="281" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="Button_Click_1"/>
            <Button x:Name="editServiceButton" Content="Редактировать услугу" HorizontalAlignment="Left" Margin="0,10,-0.2,0" VerticalAlignment="Top" Width="281" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="editServiceButton_Click"/>
            <Button x:Name="deleteServiceButton" Content="Удалить услугу" HorizontalAlignment="Left" Margin="0,10,-0.2,0" VerticalAlignment="Top" Width="281" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="deleteServiceButton_Click"/>
            <Button x:Name="toMainButton" Content="На главную" HorizontalAlignment="Left" Margin="0,30,-0.2,0" VerticalAlignment="Top" Width="281" Height="31" Click="Button_Click" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
            <Button Visibility="Collapsed" x:Name="endEditButton" Content="Завершить редактирование" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="281" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="endEditButton_Click"/>
            <Button Visibility="Collapsed" x:Name="cancelEditButton" Content="Отменить изменения" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="281" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="cancelEditButton_Click"/>
        </StackPanel>
        <Label Content="Количество услуг:" HorizontalAlignment="Left" Margin="13,441,0,0" VerticalAlignment="Top" Width="144" FontFamily="Arial" FontSize="16"/>
        <Label x:Name="countRecordsLabel" Content="" HorizontalAlignment="Left" Margin="158,441,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.26,0.246" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>

    </Grid>
    </Viewbox>
</Window>
