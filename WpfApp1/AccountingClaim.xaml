<Window x:Name="AccountingClaimForm" x:Class="WpfApp1.AccountingClaim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Учет заявок" Height="676.2" Width="1118" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Icon="internet_102151.ico" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1.62*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <DockPanel>
                    <StackPanel>
                    <Label Content="Поиск по номеру заявки и ФИО клиента" HorizontalAlignment="Left" Margin="26,11,0,0" VerticalAlignment="Top" FontSize="16" Height="30" Width="346"/>
                    <TextBox x:Name="searchByContractNumAndFio" HorizontalAlignment="Left" Height="36" Margin="28,5,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="485" TextChanged="searchByContractNumAndFio_TextChanged" PreviewTextInput="searchByContractNumAndFio_PreviewTextInput"/>
                    <DockPanel>
                        <GroupBox Header="Фильтр по статусу" HorizontalAlignment="Left" Height="116" Margin="26,5,10,0" VerticalAlignment="Top" Width="255" FontSize="16">
                            <DockPanel HorizontalAlignment="Left" Height="89" Margin="0,0,-1.8,0" VerticalAlignment="Top" Width="245">
                                <Grid>
                                    <RadioButton x:Name="allStatuses" Content="Все" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,11,0,0" Checked="FilterByStatus_Checked"/>
                                    <RadioButton x:Name="incoming" Content="Входящая" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,35,0,0" Checked="FilterByStatus_Checked"/>
                                    <RadioButton x:Name="inProgress" Content="В работе" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,60,0,0" Checked="FilterByStatus_Checked"/>
                                    <RadioButton x:Name="closed" Content="Закрыта" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="133,33,0,0" Checked="FilterByStatus_Checked" Width="83"/>
                                    <RadioButton x:Name="canceled" Content="Отменена" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="133,10,0,0" Checked="FilterByStatus_Checked"/>
                                </Grid>
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Фильтр по дате создания" HorizontalAlignment="Left" Height="115" Margin="10,5,0,0" VerticalAlignment="Top" Width="212" FontSize="16">
                            <StackPanel Margin="0,0,0,5.2">
                                <DockPanel Margin="0,5,0,0">
                                    <Label Content="С"/>
                                    <DatePicker x:Name="fromDate" Margin="10,0,0,0" SelectedDateChanged="dates_SelectedDateChanged" PreviewTextInput="Dates_PreviewTextInput"/>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <Label Content="По"/>
                                    <DatePicker x:Name="toDate" SelectedDateChanged="dates_SelectedDateChanged" PreviewTextInput="Dates_PreviewTextInput"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                    </DockPanel>
                </StackPanel>
                </DockPanel>
                <DockPanel Margin="15,0,0,0">
                    <StackPanel>
                        <Button x:Name="clearFiltersButton" Content="Очистить фильтры и поиск" HorizontalAlignment="Left" Margin="0,47,0,0" VerticalAlignment="Top" MinWidth="243" Height="32" Click="Button_Click_3" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
                        <ComboBox x:Name="reportVariantsComboBox" HorizontalAlignment="Left" Margin="0,35,0,0" VerticalAlignment="Top" MinWidth="243" Height="35" FontSize="14" SelectionChanged="reportVariantsComboBox_SelectionChanged"/>
                        <Button x:Name="printAReport" Content="Печать отчета" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" MinWidth="243" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="16" Click="printClaimButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Left" Height="212" Margin="0,40,15,0" VerticalAlignment="Top">
                <Button x:Name="showClaimButton" IsEnabled="False" Content="Просмотр заявки" HorizontalAlignment="Left" Margin="0,15,0,0" VerticalAlignment="Top" Width="267" Height="33" Click="Button_Click_1" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="16"/>
                <Button x:Name="orderButton" Content="Заказ-наряд" HorizontalAlignment="Left" Margin="0,15,0,0" VerticalAlignment="Top" Width="267" Height="33" Click="Button_Click_2" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="16"/>
                <Button x:Name="diagram" Content="Статистика" HorizontalAlignment="Left" Margin="0,15,0,0" VerticalAlignment="Top" Width="267" Height="33" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="16" Click="diagram_Click"/>
                <Button x:Name="toMainButton" Content="На главную" HorizontalAlignment="Left" Margin="0,15,0,0" VerticalAlignment="Top" Width="267" Height="33" Click="Button_Click" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontWeight="Bold" FontSize="16"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" IsReadOnly="True" SelectionMode="Single" x:Name="claimsDG" AutoGenerateColumns="False" SelectionChanged="claimsDG_SelectionChanged" FontSize="15" Margin="10,0,10,47.6" Grid.RowSpan="2">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Просмотр" Click="Button_Click_1" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding isExpired}" Value="true">
                            <Setter Property="Background" Value="#ffcc80"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заявки" Binding="{Binding id_claim}" Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Описание" Binding="{Binding claimDetails}" Width="4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding connection_creationDate, StringFormat=\{0:dd.MM.yy\}}" Width="70" Visibility="Collapsed" />
                <DataGridTextColumn Header="Дата выполнения" Binding="{Binding mount_date, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}" Width="120" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Адрес монтирования" Binding="{Binding connection_address}" Width="140" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Тариф" Binding="{Binding tariff}" Width="120" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Фио Клиента" Binding="{Binding client_fio}"  Width="1.1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="TextAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ФИО менеджера" Binding="{Binding employee_fio}" Width="1.1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="TextAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ФИО мастера" Binding="{Binding master_fio}" Width="1.1*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="TextAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding claim_cost}" Width="0.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="TextAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Статус" Width="1.1*">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding claim_status}" Value="Входящая">
                                    <Setter Property="Background" Value="ForestGreen" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding claim_status}" Value="Отменена">
                                    <Setter Property="Background" Value="DarkRed" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding claim_status}" Value="В работе">
                                    <Setter Property="Background" Value="Coral" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding claim_status}" Value="Закрыта">
                                    <Setter Property="Background" Value="Magenta" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding claim_status}" 
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0"
                       Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Background="#F9F9F9" VerticalAlignment="Top" Height="48">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnPrev" Content="◀" Width="80" Height="28" Margin="5" Click="PrevPage_Click" FontSize="13" IsEnabled="False"/>

                <TextBlock Text="Страница" VerticalAlignment="Center" Margin="10,0,5,0" FontSize="13"/>
                <TextBox x:Name="txtPageNum" Text="1" Width="40" Height="25" TextAlignment="Center" FontSize="12" 
                         PreviewTextInput="OnlyNumbers_PreviewTextInput" LostFocus="txtPageNum_LostFocus"/>
                <TextBlock Text="из" VerticalAlignment="Center" Margin="5,0" FontSize="13"/>
                <TextBlock x:Name="lblTotalPages" Text="0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>

                <Button x:Name="btnNext" Content="▶" Width="80" Height="28" Margin="15, 5, 5, 5" Click="NextPage_Click" FontSize="13" IsEnabled="False"/>
            </StackPanel>
        </Border>
        
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Label Content="Количество записей:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="16"/>
            <Label x:Name="recordsCountLabel" Content="" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
            <Rectangle Fill="#FFFFCC80" HorizontalAlignment="Left" Height="30" Margin="100,3,0,0" VerticalAlignment="Center" Width="31"/>
            <Label Content="- заявка просрочена" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="16"/>
            <DockPanel x:Name="totalSumDock" Margin="5,5,0,0" Width="386" VerticalAlignment="Center">
                <Label x:Name="incomesLabel" Content="Общий доход от заявок:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" Margin="50,0,0,0" FontSize="16"/>
                <Label x:Name="totalSumLabel" Content="" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Arial" FontSize="16" FontWeight="Bold" Margin="0,5,0,-0.2" Height="33" RenderTransformOrigin="0.449,0.727"/>
                <Label Content="руб." FontSize="16" VerticalAlignment="Center" Height="38" Margin="0,5,0, 0.2" />
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
