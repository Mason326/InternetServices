<Window x:Name="AdditionalServicesForm" x:Class="WpfApp1.AdditionalServices"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Дополнительне услуги" Height="592.4" Width="903.6" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Icon="internet_102151.ico" >
    <Viewbox Stretch="Fill">
        
    <Grid>
        <TextBox TabIndex="1" x:Name="serviceTextBox" HorizontalAlignment="Left" Height="77" Margin="626,53,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="248" PreviewTextInput="serviceTextBox_PreviewTextInput" FontSize="14"/>
        <Label Content="Услуга" HorizontalAlignment="Left" Margin="622,27,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.893,-0.273" FontSize="14"/>
        <Label Content="Оплата за месяц" HorizontalAlignment="Left" Margin="622,144,0,0" VerticalAlignment="Top" FontSize="14"/>
        <DataGrid FontSize="16" IsReadOnly="True" SelectionMode="Single" x:Name="addServicesDG" HorizontalAlignment="Left" Height="485" Margin="10,27,0,0" VerticalAlignment="Top" Width="582" AutoGenerateColumns="False" SelectionChanged="addServicesDG_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Услуга" Binding="{Binding additional_service_name}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ежемесячные выплаты" Binding="{Binding monthly_fee}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox CommandManager.PreviewExecuted="TextBox_PreviewExecuted" TabIndex="2" x:Name="monthFee" HorizontalAlignment="Left" Height="30" Margin="626,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="248" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" MaxLength="6" FontSize="14"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="666,24,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="729,141,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <StackPanel HorizontalAlignment="Left" Height="237" Margin="610,275,0,0" VerticalAlignment="Top" Width="278">
            <Button x:Name="addServiceButton" Content="Добавить услугу" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="258" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="Button_Click_1"/>
            <Button x:Name="editServiceButton" Content="Редактировать услугу" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="258" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="editServiceButton_Click"/>
            <Button x:Name="deleteServiceButton" Content="Удалить услугу" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="258" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="deleteServiceButton_Click"/>
            <Button x:Name="toMainButton" Content="На главную" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top" Width="258" Height="31" Click="Button_Click" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
            <Button x:Name="endEditButton" Visibility="Collapsed" Content="Завершить редактирование" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="258" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="endEditButton_Click"/>
            <Button x:Name="cancelEditButton" Visibility="Collapsed" Content="Отменить изменения" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"  Width="258" Height="31" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="cancelEditButton_Click"/>
        </StackPanel>
        <Label Content="Количество доп. услуг:" HorizontalAlignment="Left" Margin="11,527,0,0" VerticalAlignment="Top" Width="180" FontFamily="Arial" FontSize="16"/>
        <Label x:Name="countRecordsLabel" Content="" HorizontalAlignment="Left" Margin="193,527,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.26,0.246" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>

    </Grid>
    </Viewbox>
</Window>
