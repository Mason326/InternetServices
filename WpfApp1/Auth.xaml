<Window x:Name="AuthForm" x:Class="WpfApp1.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Авторизация" 
        Height="617" 
        Width="900" 
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="SingleBorderWindow" 
        PreviewKeyUp="Window_PreviewKeyUp" 
        Loaded="Window_Loaded" 
        Icon="internet_102151.ico"
        ResizeMode="CanResizeWithGrip" Closing="Window_Closing">

    <Window.Resources>
        <!-- Стиль для кнопки авторизации -->
        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4F6DD3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E5BC4"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF2E4BB4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для иконок -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="47"/>
            <Setter Property="Height" Value="45"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
               Source="Resources/Images/Inet.jpg" 
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="White">
            <StackPanel Margin="25,20,25,20">
                <DockPanel Margin="0,0,0,5" HorizontalAlignment="Right">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Button_Click_3">
                        <Button.Background>
                            <ImageBrush ImageSource="Resources/Images/exit.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Margin="10,0,15,0"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Button_Click_2">
                        <Button.Background>
                            <ImageBrush ImageSource="Resources/Images/GearIcon.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </DockPanel>

                <StackPanel Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Логин" Padding="0"/>
                        <Label Foreground="Red" 
                               Content="*" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="1,0,0,0"
                               Padding="0"/>
                    </StackPanel>
                    <TextBox x:Name="LoginTextbox" />
                </StackPanel>

                <StackPanel Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Пароль" Padding="0"/>
                        <Label Foreground="Red" 
                               Content="*" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="1,0,0,0"
                               Padding="0"/>
                    </StackPanel>
                    <PasswordBox x:Name="PasswordTextBox" />
                </StackPanel>

                <StackPanel x:Name="CaptchaPanel" Margin="0,0,0,7" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label x:Name="captchaLabel" Content="Капча" Padding="0"/>
                        <Label Foreground="Red" 
                               x:Name="captchaAsterisk"
                               Content="*" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Margin="1,0,0,0"
                               Padding="0"/>
                    </StackPanel>

                    <TextBox x:Name="captchaTextbox" Margin="0,0,0,15"/>
                    <Border BorderBrush="#FFCCCCCC" 
                            BorderThickness="1" 
                            Background="#FFF9F9F9"
                            Margin="0,0,0,10"
                            CornerRadius="4">
                        <Image x:Name="captchaImage" 
                               Height="133" 
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="10"/>
                    </Border>
                    <Button x:Name="refreshButton" 
                            Content=""
                            Height="36"
                            HorizontalAlignment="Center"
                            Foreground="White"
                            FontFamily="Arial"
                            FontSize="14"
                            FontWeight="Bold"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            Click="RefreshButton_Click" Width="74">
                        <Button.Background>
                            <ImageBrush ImageSource="Resources/Images/RefreshIcon.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <Button x:Name="AuthButton" 
                        Content="Авторизоваться"
                        Margin="0,5,0,0"
                        Style="{StaticResource AuthButtonStyle}" Click="AuthButton_Click"/>

                <Button Content="Выход"
                        Margin="0,10,0,0"
                        Height="40"
                        Background="#FFDC3545"
                        Foreground="White"
                        FontFamily="Arial"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Click="Button_Click_3"
                        Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>