<Window x:Name="AccountingContractForm" x:Class="WpfApp1.AccountingContract"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Учет договоров" Height="644.001" Width="987.2" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Icon="internet_102151.ico" SizeChanged="Window_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1.82*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <GroupBox Header="Фильтр по статусу" HorizontalAlignment="Left" Height="123" Margin="297,6,0,0" VerticalAlignment="Top" Width="162" FontSize="16">
                    <StackPanel HorizontalAlignment="Left" Height="89" VerticalAlignment="Top" Width="147">
                        <RadioButton x:Name="allContracts" Content="Все" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,15,0,0" Checked="FilterByStatus_Checked"/>
                        <RadioButton x:Name="currentContracts" Content="Заключен" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,5,0,0" Checked="FilterByStatus_Checked"/>
                        <RadioButton x:Name="terminatedContracts" Content="Расторгнут" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,5,0,0" Checked="FilterByStatus_Checked"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Фильтр по дате заключения" HorizontalAlignment="Left" Height="121" Margin="36,0,0,0" VerticalAlignment="Top" Width="231" FontSize="16">
                    <StackPanel Margin="0,0,0.2,14.6">
                        <DockPanel Margin="0,5,0,0">
                            <Label Content="С"/>
                            <DatePicker Margin="10,0,0,0" Name="fromDate" Width="189" SelectedDateChanged="dates_SelectedDateChanged" PreviewTextInput="Dates_PreviewTextInput"/>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <Label Content="По"/>
                            <DatePicker Name="toDate" SelectedDateChanged="dates_SelectedDateChanged" PreviewTextInput="Dates_PreviewTextInput"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <Label Content="Поиск по номеру договора и ФИО" HorizontalAlignment="Left" Margin="8,116,0,0" VerticalAlignment="Top" FontSize="16" Height="30" Width="291"/>
                <TextBox x:Name="searchByContractNumAndFio" HorizontalAlignment="Left" Height="36" Margin="10,146,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="421" TextChanged="searchByContractNumAndFio_TextChanged" PreviewTextInput="searchByContractNumAndFio_PreviewTextInput"/>
                <GroupBox Header="Сортировка по номеру&#xD;&#xA;договора" HorizontalAlignment="Left" Height="123" Margin="503,5,0,0" VerticalAlignment="Top" Width="192" FontSize="16">
                    <StackPanel HorizontalAlignment="Left" Height="81" VerticalAlignment="Top" Width="147" Margin="0,0,0,-7.4">
                        <RadioButton x:Name="noSort" Content="Отсутствует" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,10,0.0,0" Checked="SortByContractNumber_Checked"/>
                        <RadioButton x:Name="asc" Content="По возрастанию" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,5,0.0,0" Checked="SortByContractNumber_Checked"/>
                        <RadioButton x:Name="desc" Content="По убыванию" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="10,5,0.0,0" Checked="SortByContractNumber_Checked"/>
                    </StackPanel>
                </GroupBox>
                <Button x:Name="clearFilters" Content="Очистить фильтры и поиск" HorizontalAlignment="Left" Margin="453,144,0,0" VerticalAlignment="Top" Width="242" Height="36" FontFamily="Arial" FontSize="16" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" Click="Button_Click_2" />
            </Grid>
            <StackPanel Grid.Column="1" HorizontalAlignment="Left" Height="154" Margin="0,32,15,0" VerticalAlignment="Top" Width="226">
                <Button x:Name="showContractVerbose" Content="Просмотр договора" HorizontalAlignment="Left" Height="36" Margin="0,10,0,0" VerticalAlignment="Top" Width="226" RenderTransformOrigin="0.458,-0.148" Click="Button_Click" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
                <Button x:Name="printAReportButton" Content="Печать отчета" HorizontalAlignment="Left" Height="36" Margin="0,10,0,0" VerticalAlignment="Top" Width="226" RenderTransformOrigin="0.458,-0.148" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold" Click="printAReportButton_Click"/>
                <Button x:Name="toMain" Content="На главную" HorizontalAlignment="Left" Height="36" Margin="0,10,0,0" VerticalAlignment="Top" Width="226" RenderTransformOrigin="0.458,-0.148" Click="Button_Click_1" Background="#FF4F6DD3" Foreground="White" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" IsReadOnly="True" SelectionMode="Single" x:Name="contractsDG" Margin="10,0,9.8,0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="contractsDG_SelectionChanged" FontSize="15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Договора" Binding="{Binding idcontract}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="№ Заявки" Binding="{Binding connection_claim_id}" Width="100" Visibility="Collapsed" />
                <DataGridTextColumn Header="ФИО Клиента" Binding="{Binding client}" Width="100" Visibility="Collapsed" />
                <DataGridTextColumn Header="Тариф" Binding="{Binding tariff}" Width="110" Visibility="Collapsed" />
                <DataGridTextColumn Header="Адрес" Binding="{Binding connection_address}" Width="90" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Дата заявки" Binding="{Binding claimDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="120" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding contractDetails}" Width="4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата заключения" Binding="{Binding contract_date, StringFormat=\{0:dd.MM.yyyy\}}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Статус" Width="*">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding status}" Value="Заключен">
                                    <Setter Property="Background" Value="ForestGreen" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding status}" Value="Расторгнут">
                                    <Setter Property="Background" Value="DarkRed" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding status}" 
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0"
                       Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Background="#F9F9F9" VerticalAlignment="Bottom" Height="39" Margin="12,0,7.8,14.6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnPrev" Content="◀" Width="80" Height="28" Margin="5" Click="PrevPage_Click" FontSize="13" IsEnabled="False"/>

                <TextBlock Text="Страница" VerticalAlignment="Center" Margin="10,0,5,0" FontSize="13"/>
                <TextBox x:Name="txtPageNum" Text="1" Width="40" Height="25" TextAlignment="Center" FontSize="12" 
                 PreviewTextInput="OnlyNumbers_PreviewTextInput" LostFocus="txtPageNum_LostFocus"/>
                <TextBlock Text="из" VerticalAlignment="Center" Margin="5,0" FontSize="13"/>
                <TextBlock x:Name="lblTotalPages" Text="0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>

                <Button x:Name="btnNext" Content="▶" Width="80" Height="28" Margin="5" Click="NextPage_Click" FontSize="13" IsEnabled="False"/>

            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3">
            <Label Content="Количество записей:" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="16"/>
            <Label x:Name="recordsCountLabel" Content="" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
        </DockPanel>
    </Grid>
</Window>
