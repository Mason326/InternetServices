<Window x:Class="WpfApp1.CreateUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Пользователи" 
        Height="600" 
        Width="1050" 
        MinHeight="550"
        MinWidth="950"
        WindowStyle="SingleBorderWindow" 
        Loaded="Window_Loaded" 
        WindowStartupLocation="CenterScreen" 
        Icon="internet_102151.ico"
        SizeChanged="Window_SizeChanged"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4F6DD3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E5BC4"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF2E4BB4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="ФИО" FontSize="15" VerticalAlignment="Center"/>
                        <Label Foreground="Red" Content="*" FontSize="18" FontWeight="Bold" Margin="-5,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="fioTextBox" Width="Auto" 
                             PreviewKeyUp="fioTextBox_PreviewKeyUp" 
                             PreviewTextInput="fioTextBox_PreviewTextInput" Height="27" Margin="0,0,-0.4,0"/>
                </StackPanel>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Роль" FontSize="15" VerticalAlignment="Center"/>
                            <Label Foreground="Red" Content="*" FontSize="18" FontWeight="Bold" Margin="-5,0,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="rolesComboBox" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Телефон" FontSize="15" VerticalAlignment="Center"/>
                            <Label Foreground="Red" Content="*" FontSize="18" FontWeight="Bold" Margin="-5,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="phoneTextBox" MaxLength="19"
                                 GotFocus="phoneTextBox_GotFocus" 
                                 GotMouseCapture="phoneTextBox_GotMouseCapture" 
                                 PreviewKeyUp="phoneTextBox_PreviewKeyUp" 
                                 PreviewTextInput="phoneTextBox_PreviewTextInput" Height="32" Margin="0,0,0.2,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Логин" FontSize="15" VerticalAlignment="Center"/>
                        <Label Foreground="Red" Content="*" FontSize="18" FontWeight="Bold" Margin="-5,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="loginTextBox" MaxLength="20" Height="28" Margin="0,0,-0.2,0"/>
                </StackPanel>

                <StackPanel Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Пароль" FontSize="15" VerticalAlignment="Center"/>
                        <Label Foreground="Red" Content="*" FontSize="18" FontWeight="Bold" Margin="-5,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="passwordTextBox" MaxLength="20" TextChanged="passwordTextBox_TextChanged" Height="32" Margin="0,0,-0.2,0"/>
                </StackPanel>

                <Button x:Name="generateButton" Content="Сгенерировать" 
                        Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White"
                        Margin="0,15,0,0"
                        Click="Button_Click_1"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="10,0" HorizontalAlignment="Center">
                <Image x:Name="userImage" Width="150" Height="150" 
                       Source="Resources/Images/user.png" 
                       Stretch="UniformToFill"
                       Margin="0,5"/>
                <Button x:Name="uploadImageButton" Content="Загрузить изображение" 
                        Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White"
                        Margin="0,10,0,0" Click="Button_Click_3"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" 
                      FontSize="16" 
                      IsReadOnly="True" 
                      FontFamily="Segoe UI"
                      x:Name="userDG" 
                      AutoGenerateColumns="False" 
                      SelectionChanged="userDG_SelectionChanged" 
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Path=idemployees}" Width="*"/>

                    <DataGridTextColumn Header="Информация о сотруднике" Binding="{Binding userData}" Width="4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Фото" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding UserPhoto}" Width="80" Height="80" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Width="285" Margin="10,0,0,0" VerticalAlignment="Center">
                <Button x:Name="createUserButton" Content="Создать пользователя" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White" Margin="0,5"
                        Click="Button_Click_2"/>

                <Button x:Name="editUserButton" Content="Редактировать пользователя" 
                       Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White" Margin="0,5"
                        Click="editUserButton_Click"/>

                <Button x:Name="deleteUserButton" Content="Удалить пользователя" 
                       Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White" Margin="0,5"
                        Click="deleteUserButton_Click"/>

                <Button x:Name="toMainButton" Content="На главную" 
                        Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White"
                        Click="Button_Click"/>

                <Button x:Name="endEditingButton" Content="Завершить редактирование" 
                       Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White" Margin="0,5" Visibility="Collapsed"
                        Click="endEditingButton_Click"/>

                <Button x:Name="cancelChangesButton" Content="Отменить изменения" 
                        Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF4F6DD3" FontFamily="Arial" Foreground="White" Margin="0,5" Visibility="Collapsed"
                        Click="cancelChangesButton_Click"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="10,0,10,10">
            <Label Content="Количество пользователей:" FontSize="14" VerticalAlignment="Center"/>
            <Label x:Name="countRecordsLabel" Content="0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>