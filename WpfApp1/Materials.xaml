<Window x:Class="WpfApp1.Materials"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Материалы" Height="527.9" Width="913.2" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Loaded="Window_Loaded" Icon="internet_102151.ico">
    <Viewbox Stretch="Fill">
        <Grid>
        <TextBox HorizontalAlignment="Left" Height="30" Margin="608,38,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210"/>
        <Label Content="Материал" HorizontalAlignment="Left" Margin="608,12,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.893,-0.273" FontSize="14"/>
        <Label Content="Цена" HorizontalAlignment="Left" Margin="608,163,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Единицы измерения" HorizontalAlignment="Left" Margin="608,105,0,0" VerticalAlignment="Top" FontSize="14"/>
        <DataGrid FontSize="16" IsReadOnly="True" SelectionMode="Single" x:Name="materialsDG" AutoGenerateColumns="False" HorizontalAlignment="Left" Height="428" Margin="14,19,0,0" VerticalAlignment="Top" Width="571" SelectionChanged="materialsDG_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Материал" Binding="{Binding material_name}" Width="295">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Единицы измерения" Binding="{Binding units}" Width="160" />
                <DataGridTextColumn Header="Цена" Binding="{Binding cost}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox CommandManager.PreviewExecuted="TextBox_PreviewExecuted" TabIndex="3" x:Name="materialCostTextBox" HorizontalAlignment="Left" Height="30" Margin="608,190,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="262" PreviewTextInput="TextBox_PreviewTextInput_2" PreviewKeyDown="TextBox_PreviewKeyDown" MaxLength="6" FontSize="14"/>
        <TextBox TabIndex="1" x:Name="materialNameTextBox" HorizontalAlignment="Left" Height="67" Margin="608,38,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="262" PreviewTextInput="TextBox_PreviewTextInput" FontSize="14"/>
        <TextBox TabIndex="2" x:Name="materialUnitTextBox" HorizontalAlignment="Left" Height="30" Margin="608,131,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="262" PreviewTextInput="TextBox_PreviewTextInput_1" FontSize="14"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="672,11,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="740,103,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <Label Foreground="Red" Content="*" HorizontalAlignment="Left" Margin="642,161,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <StackPanel HorizontalAlignment="Left" Height="201" Margin="608,246,20,0" VerticalAlignment="Top" Width="262">
            <Button x:Name="addMaterialButton" Content="Добавить материал" HorizontalAlignment="Left" VerticalAlignment="Top" Width="262" Height="31" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16" Click="Button_Click_1"/>
            <Button x:Name="editMaterialButton" Content="Редактировать материал" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="262" Height="31" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16" Click="editMaterialButton_Click"/>
            <Button x:Name="deleteMaterialButton" Content="Удалить материал" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="262" Height="31" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16" Click="deleteMaterialButton_Click"/>
            <Button x:Name="toMainButton" Content="На главную" HorizontalAlignment="Left" Margin="0,58,0,0" VerticalAlignment="Top" Width="262" Height="31" Click="Button_Click" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16"/>
            <Button x:Name="endEditButton" Content="Завершить редактирование" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top"  Width="262" Height="31" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16" Click="endEditButton_Click"/>
            <Button x:Name="cancelEditButton" Content="Отменить изменения" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="262" Height="31" Background="#FF4F6DD3" Foreground="White" FontWeight="Bold" FontFamily="Arial" FontSize="16" Click="cancelEditButton_Click"/>
        </StackPanel>
        <Label Content="Количество материалов:" HorizontalAlignment="Left" Margin="17,461,0,0" VerticalAlignment="Top" Width="196" FontFamily="Arial" FontSize="16"/>
        <Label x:Name="countRecordsLabel" Content="" HorizontalAlignment="Left" Margin="216,461,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.26,0.246" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
    </Grid>
    </Viewbox>
</Window>
